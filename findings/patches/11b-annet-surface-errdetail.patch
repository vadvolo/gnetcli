+
+// describeGnetcliErr turns gnetcli's opaque gRPC status ("generic_error" /
+// "connect_error") into a diagnosable string by pulling the ErrorInfo detail
+// (Reason + Metadata["err"], the real underlying cause) that the gnetcli server
+// attaches. The original code word is preserved as a substring so existing
+// Contains-based classification/retry (isRetryableCmdErr) keeps working, e.g.:
+//
+//	connect_error [handshake_error]: ssh: handshake failed: no common algorithm for key exchange
+//	connect_error [auth_error]: ... unable to authenticate, attempted methods [none password]
+//	generic_error [session_eof]: ... EOF
+func describeGnetcliErr(err error) string {
+	st, ok := status.FromError(err)
+	if !ok {
+		return err.Error()
+	}
+	code := st.Message() // generic_error | connect_error
+	var reason, detail string
+	for _, d := range st.Details() {
+		if info, ok := d.(*errdetails.ErrorInfo); ok {
+			reason = info.GetReason()
+			if m := info.GetMetadata(); m != nil {
+				detail = m["err"]
+			}
+			break
+		}
+	}
+	out := code
+	if reason != "" && reason != code {
+		out += " [" + reason + "]"
+	}
+	if detail != "" {
+		if i := strings.IndexAny(detail, "\r\n"); i >= 0 {
+			detail = detail[:i]
+		}
+		out += ": " + detail
+	}
+	return out
+}
